            "Get_Execution_for_Carousel": [
              "Succeeded"
            ]
          }
        },
        "Get_Execution_for_Carousel": {
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "referenceName": "googlesheet_#workflowname#"
              }
            },
            "method": "post",
            "path": "/datasets/@{encodeURIComponent(encodeURIComponent('1WEUHeQXFMYsWVAW3DykWwpANxxD3DxH-S6c0i06dW1g'))}/tables/@{encodeURIComponent(encodeURIComponent('1315784118'))}/items",
            "body": {}
          },
          "metadata": {
            "flowSystemMetadata": {
              "swaggerOperationId": "PostItem"
            }
          },
          "runAfter": {}
        },
        "Upload_images_to_Cloudinary": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "https://api.cloudinary.com/v1_1/<your-cloud-name>/image/upload",
            "body": {
              "file": null,
              "upload_preset": "<your_upload_preset>"
            }
          },
          "runAfter": {
            "Download_Image_from_Google_Drive_Carousel": [
              "Succeeded"
            ]
          }
        },
        "Setup_for_Instagram_access_token_ig_business_id": {
          "type": "Compose",
          "inputs": {
            "access_token": "<your-instagram-access-token>",
            "ig_user_id": "<your-ig_user_id>",
            "image_url": "@body('Upload_images_to_Cloudinary')?['url']",
            "caption": "@body('Get_Execution_for_Carousel')?['Expected content']"
          },
          "runAfter": {
            "Upload_images_to_Cloudinary": [
              "Succeeded"
            ]
          }
        },
        "Download_Image_from_Google_Drive_Carousel": {
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "https://drive.google.com/uc?export=download&id=@{body('Get_image_list_from_a_Google_Drive_folder1')?['id']}"
          },
          "runAfter": {
            "Get_image_list_from_a_Google_Drive_folder1": [
              "Succeeded"
            ]
          }
        },
        "Create_Media_Container_Image": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "https://graph.instagram.com/v23.0/@{body('Setup_for_Instagram_access_token_ig_business_id')?['ig_user_id']}/media",
            "body": {
              "image_url": "@body('Setup_for_Instagram_access_token_ig_business_id')?['image_url']",
              "caption": "@body('Setup_for_Instagram_access_token_ig_business_id')?['caption']",
              "access_token": "@body('Setup_for_Instagram_access_token_ig_business_id')?['access_token']"
            }
          },
          "runAfter": {
            "Setup_for_Instagram_access_token_ig_business_id": [
              "Succeeded"
            ]
          }
        },
        "Combine_Instagram_media_containers": {
          "type": "Compose",
          "inputs": {
            "conversionStatus": "unsupported",
            "n8nNodeName": "Combine Instagram media containers",
            "n8nNodeType": "n8n-nodes-base.aggregate",
            "message": "Replace this placeholder with an equivalent LAA action."
          },
          "description": "Generated placeholder for an unsupported n8n node.",
          "metadata": {
            "x-n8n-original-parameters": {
              "options": {
                "mergeLists": true
              },
              "fieldsToAggregate": {
                "fieldToAggregate": [
                  {
                    "fieldToAggregate": "body.id"
                  }
                ]
              }
            }
          },
          "runAfter": {
            "Create_Media_Container_Image": [
              "Succeeded"
            ]
          }
        },
        "Create_Media_Container_Carousel": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "https://graph.instagram.com/v23.0/@{first(body('Setup_for_Instagram_access_token_ig_business_id'))?['ig_user_id']}/media",
            "body": {
              "caption": "@body('Get_Execution_for_Carousel')?['Expected content']",
              "media_type": "=CAROUSEL",
              "children": "@body('Combine_Instagram_media_containers')?['id']",
              "access_token": "@first(body('Setup_for_Instagram_access_token_ig_business_id'))?['access_token']"
            }
          },
          "runAfter": {
            "Combine_Instagram_media_containers": [
              "Succeeded"
            ]
          }
        },
        "Publish_Instagram_Carousel": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "https://graph.instagram.com/v23.0/@{first(body('Setup_for_Instagram_access_token_ig_business_id'))?['ig_user_id']}/media_publish",
            "body": {
              "creation_id": "@body('Create_Media_Container_Carousel')?['body']?['id']",
              "access_token": "@first(body('Setup_for_Instagram_access_token_ig_business_id'))?['access_token']"
            }
          },
          "runAfter": {
            "Create_Media_Container_Carousel": [
              "Succeeded"
            ]
          }
        },
