                      "combinator": "and",
                      "conditions": [
                        {
                          "id": "e94de530-6451-48aa-892c-924a9c41cfb0",
                          "operator": {
                            "name": "filter.operator.equals",
                            "type": "string",
                            "operation": "equals"
                          },
                          "leftValue": "={{ $json.data['Confirm  Content?'] }}",
                          "rightValue": "Cancel"
                        }
                      ]
                    },
                    "renameOutput": true
                  }
                ]
              },
              "options": {}
