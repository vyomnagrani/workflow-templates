                          "operator": {
                            "name": "filter.operator.equals",
                            "type": "string",
                            "operation": "equals"
                          },
                          "leftValue": "={{ $json.data['Confirm  Content?'] }}",
                          "rightValue": "No"
                        }
                      ]
                    },
                    "renameOutput": true
