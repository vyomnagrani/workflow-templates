    ]
  },
  "workflow": {
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "triggers": {
        "Manual_Trigger": {
          "type": "Request",
          "kind": "Http"
        }
      },
      "actions": {
        "Telegram_Trigger": {
          "type": "Compose",
          "inputs": {
            "conversionStatus": "unsupported",
            "n8nNodeName": "Telegram Trigger",
            "n8nNodeType": "n8n-nodes-base.telegramTrigger",
            "message": "Replace this placeholder with an equivalent LAA action."
          },
          "description": "Generated placeholder for an unsupported n8n node.",
          "metadata": {
            "x-n8n-original-parameters": {
              "updates": [
                "message"
              ],
              "additionalFields": {}
            }
          },
          "runAfter": {}
        },
        "Workflow_Configuration": {
          "type": "Compose",
          "inputs": {
            "elevenLabsApiKey": "YOUR_ELEVENLABS_API_KEY",
            "elevenLabsVoiceId": "YOUR_VOICE_ID",
            "falApiKey": "YOUR_FAL_API_KEY",
            "scriptMaxDuration": 30,
            "perplexityModel": "sonar"
          },
          "runAfter": {
            "Telegram_Trigger": [
              "Succeeded"
            ]
          }
        },
        "Extract_Photo_and_Theme": {
          "type": "Compose",
          "inputs": {
            "photoUrl": "@body('Workflow_Configuration')?['message']?['photo'] ? body('Workflow_Configuration')?['message']?['photo'][body('Workflow_Configuration')?['message']?['photo']?['length'] - 1].file_id : ''",
            "theme": "@body('Workflow_Configuration')?['message']?['caption'] || body('Workflow_Configuration')?['message']?['text'] || 'viral content'"
          },
          "runAfter": {
            "Workflow_Configuration": [
              "Succeeded"
            ]
          }
        },
        "Search_Trends_with_Perplexity": {
          "type": "Compose",
          "inputs": {
            "conversionStatus": "unsupported",
            "n8nNodeName": "Search Trends with Perplexity",
            "n8nNodeType": "n8n-nodes-base.perplexity",
            "message": "Replace this placeholder with an equivalent LAA action."
          },
          "description": "Generated placeholder for an unsupported n8n node.",
          "metadata": {
            "x-n8n-original-parameters": {
              "model": "={{ $('Workflow Configuration').first().json.perplexityModel }}",
              "options": {},
              "messages": {
                "message": [
                  {
                    "content": "={{ \n  \"Find the top 3 current viral trends related to: \" + $('Extract Photo and Theme').item.json.message.caption + \n  \". Focus on trending topics, hashtags, and content styles that are performing well on TikTok right now. \" + \n  \"Be specific and actionable. Limit your response strictly to 3 results only — no more.\" \n}}"
                  }
                ]
              },
              "requestOptions": {}
            }
          },
          "runAfter": {
            "Build_Public_Image_URL": [
              "Succeeded"
            ]
          }
        },
        "Generate_Script_with_GPT_4": {
          "type": "Compose",
          "inputs": {
            "conversionStatus": "unsupported",
            "n8nNodeName": "Generate Script with GPT-4",
            "n8nNodeType": "@n8n/n8n-nodes-langchain.openAi",
            "message": "Replace this placeholder with an equivalent LAA action."
          },
          "description": "Generated placeholder for an unsupported n8n node.",
          "metadata": {
            "x-n8n-original-parameters": {
              "modelId": {
                "__rl": true,
                "mode": "id",
                "value": "gpt-4o-mini"
              },
              "options": {},
              "messages": {
                "values": [
                  {
                    "content": "=Based on these trends: {{ $json.choices[0].message.content }}\n\nCreate a viral 30-second maximum TikTok script about: {{ $('Extract Photo and Theme').first().json.theme }}\n\nRequirements:\n- Maximum 30 seconds when spoken\n- Hook in first 2 seconds\n- Engaging and conversational\n- Optimized for voice synthesis\n- No special characters or formatting\n- Return ONLY the script text, nothing else"
                  }
                ]
              }
            }
          },
          "runAfter": {
            "Search_Trends_with_Perplexity": [
              "Succeeded"
            ]
          }
        },
        "ElevenLabs_Voice_Synthesis": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "@'https://api.elevenlabs.io/v1/text-to-speech/' + first(body('Workflow_Configuration'))?['elevenLabsVoiceId']",
            "headers": {
              "xi-api-key": "@first(body('Workflow_Configuration'))?['elevenLabsApiKey']",
              "Content-Type": "application/json",
              "Accept": "audio/mpeg"
            },
            "body": "@{\n    \"text\": body('Generate_Script_with_GPT_4')?['message']?['content'],\n    \"model_id\": \"eleven_multilingual_v2\",\n    \"voice_settings\": {\n      \"stability\": 0.5,\n      \"similarity_boost\": 0.75\n    }\n  }"
          },
          "runAfter": {
            "Generate_Script_with_GPT_4": [
              "Succeeded"
            ]
          }
        },
        "FAL_ai_Video_Generation": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "https://queue.fal.run/veed/fabric-1.0",
            "headers": {
              "Authorization": "@first(body('Workflow_Configuration'))?['falApiKey']",
              "Content-Type": "application/json"
            },
            "body": "={{ { \"image_url\": $('Build Public Image URL').first().json.data.url.replace(/^http:\\/\\/tmpfiles\\.org\\/(\\d+)\\/(.*)$/i, 'https://tmpfiles.org/dl/$1/$2'), \"audio_url\": $json.data.url.replace(/^http:\\/\\/tmpfiles\\.org\\/(\\d+)\\/(.*)$/i, 'https://tmpfiles.org/dl/$1/$2'), \"resolution\": \"480p\" } }}"
          },
          "runAfter": {
            "Upload_Audio_to_Public_URL": [
              "Succeeded"
            ]
          }
        },
        "Generate_Caption_with_GPT_4": {
          "type": "Compose",
          "inputs": {
            "conversionStatus": "unsupported",
            "n8nNodeName": "Generate Caption with GPT-4",
            "n8nNodeType": "@n8n/n8n-nodes-langchain.openAi",
            "message": "Replace this placeholder with an equivalent LAA action."
          },
          "description": "Generated placeholder for an unsupported n8n node.",
          "metadata": {
            "x-n8n-original-parameters": {
              "modelId": {
                "__rl": true,
                "mode": "id",
                "value": "gpt-4o-mini"
              },
              "options": {},
              "messages": {
                "values": [
                  {
                    "content": "=Create an engaging TikTok caption for a video about: {{ $('Extract Photo and Theme').first().json.theme }}\n\nBased on these trends: {{ $('Search Trends with Perplexity').first().json.choices[0].message.content }}\n\nRequirements:\n- Catchy hook in first line\n- Include 5-8 relevant trending hashtags\n- Keep it concise and engaging\n- Optimize for TikTok algorithm\n- Return ONLY the caption text with hashtags, nothing else"
                  }
                ]
              }
            }
          },
          "runAfter": {
            "Download_VEED_Video": [
              "Succeeded"
            ]
          }
        },
        "Save_to_Google_Sheets": {
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "referenceName": "googlesheet_#workflowname#"
              }
            },
            "method": "post",
            "path": "/datasets/@{encodeURIComponent(encodeURIComponent('REPLACE_WITH_SPREADSHEET_ID'))}/tables/@{encodeURIComponent(encodeURIComponent('REPLACE_WITH_WORKSHEET'))}/items",
            "body": {
              "IDEA": "@first(body('Extract_Photo_and_Theme'))?['message']?['caption']",
              "CAPTION": "@body('Generate_Caption_with_GPT_4')?['message']?['content']",
              "URL AUDIO": "@first(body('Upload_Audio_to_Public_URL'))?['data']?['url']",
              "URL IMAGE": "@first(body('Build_Public_Image_URL'))?['data']?['url']",
              "URL VIDEO": "@body('Download_VEED_Video')?['video']?['url']"
            }
          },
          "metadata": {
            "flowSystemMetadata": {
              "swaggerOperationId": "PostItem"
            }
          },
          "runAfter": {
            "Generate_Caption_with_GPT_4": [
              "Succeeded"
            ]
          }
        },
