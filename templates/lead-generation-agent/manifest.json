            "Append_row_in_sheet": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "referenceName": "googlesheet_#workflowname#"
                  }
                },
                "method": "post",
                "path": "/datasets/@{encodeURIComponent(encodeURIComponent('1LmOvSzCOAlrgxQg5r77eVkyJWw3V0VDUAWgkoHWql1Y'))}/tables/@{encodeURIComponent(encodeURIComponent('gid=0'))}/items",
                "body": {
                  "Address": "@body('Filter')?['address']",
                  "Website": "@body('Filter')?['website']",
                  "Category": "@body('Filter')?['categoryName']",
                  "Company Name": "@body('Filter')?['title']",
                  "Email Address": "@triggerBody()?['output']?['Email Address']",
                  "Phone Nummber": "@body('Filter')?['phoneUnformatted']"
                }
              },
              "metadata": {
                "flowSystemMetadata": {
                  "swaggerOperationId": "PostItem"
                }
              },
              "runAfter": {}
            },
            "Send_a_message": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "referenceName": "gmail_#workflowname#"
                  }
                },
                "method": "post",
                "path": "/v2/Mail",
                "body": {
                  "To": "@body('Edit_Fields1')?['Email Address']",
                  "Subject": "@body('Information_Extractor1')?['output']?['Mail Subject']",
                  "Body": "@body('Information_Extractor1')?['output']?['Mail Body']"
                }
              },
              "metadata": {
                "flowSystemMetadata": {
                  "swaggerOperationId": "SendEmailV2"
                }
              },
              "runAfter": {
                "Edit_Fields1": [
                  "Succeeded"
                ]
              }
            },
            "Information_Extractor1": {
              "type": "Compose",
              "inputs": {
                "conversionStatus": "unsupported",
                "n8nNodeName": "Information Extractor1",
                "n8nNodeType": "@n8n/n8n-nodes-langchain.informationExtractor",
                "message": "Replace this placeholder with an equivalent LAA action."
              },
              "description": "Generated placeholder for an unsupported n8n node.",
              "metadata": {
                "x-n8n-original-parameters": {
                  "text": "=You are a perfect cold mail generator for a Digital Marketing Agency named Upward Engine.\n\nHere's the Information about the Recipient:\n\nCompany Name: {{ $('Loop Over Items').item.json['Company Name'] }}\nBusiness Type: {{ $('Loop Over Items').item.json.Category }}\n\nEmail Style / Email Tune : {{ $json['Email Style'] }}\n\nThe Email style is given just to understand how the mail will be.\n\nInstructions:\n\n1. Always start with giving a greting to the Company like Hi Company Name,\n2. Always use We not I.\n3. Mail have to be professional, Clean and to the point\n4. At last give a Signeture Like:\n   [Your Name]\n  [Your Company/Agency Name]",
                  "options": {},
                  "attributes": {
                    "attributes": [
                      {
                        "name": "Mail Subject",
                        "required": true,
                        "description": "Eye catchy mail Subject for the cold mail"
                      },
                      {
                        "name": "Mail Body",
                        "required": true,
                        "description": "=body message of the mail, a perfect and clear cold mail."
                      }
                    ]
                  }
                }
              },
              "runAfter": {
