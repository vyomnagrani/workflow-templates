            "message": "Replace this placeholder with an equivalent LAA action."
          },
          "description": "Generated placeholder for an unsupported n8n node.",
          "metadata": {
            "x-n8n-original-parameters": {
              "options": {}
            }
          },
          "runAfter": {}
