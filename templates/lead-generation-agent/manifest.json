          },
          "runAfter": {
            "HTTP_Request": [
              "Succeeded"
            ]
          }
        },
        "If": {
          "type": "If",
          "expression": {
            "contains": [
              "@body('Information_Extractor')?['output']?['Email Address']",
              "@"
            ]
          },
